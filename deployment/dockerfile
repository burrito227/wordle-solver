FROM --platform=linux/amd64 public.ecr.aws/docker/library/python:3.9-slim-bookworm

# Database Configuration
ENV MSSQL_SA_PASSWORD=121612Vader?
ENV DB_PASSWORD=121612Vader?
ENV DB_HOST=host.docker.internal
ENV DB_PORT=1433
ENV DB_NAME=wordle
ENV DB_USER=sa

# Install system dependencies for pyodbc and SQL Server
RUN apt-get update && apt-get install -y \
    curl \
    apt-transport-https \
    gnupg \
    unixodbc-dev \
    unixodbc \
    && curl https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=amd64,arm64,armhf signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y msodbcsql18 \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . /deployment

CMD python /deployment/pre_deployment.py